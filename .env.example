# ==============================================================================
# Variáveis de Ambiente - sboot-api-biblioteca (.env.example)
# Copie este arquivo para .env na raiz de sboot-api-biblioteca:
#   cp .env.example .env
# NUNCA commite o arquivo .env no controle de versão.
# ==============================================================================

# ===== Docker Compose & Infraestrutura =====
POSTGRES_DB=biblioteca
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ===== Banco de Dados (Spring Boot standalone) =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# ===== RabbitMQ (Spring Boot standalone) =====
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===== JWT (Obrigatório) =====
# Gere um segredo forte base64 com 256 bits:
#   openssl rand -base64 32
JWT_SECRET=cole_aqui_o_secret_gerado_com_openssl_rand_base64_32

# Durante rotação de segredo SEM downtime, defina a chave anterior aqui:
JWT_PREVIOUS_SECRET=

# Duração do access token (ms). Padrão: 7 minutos = 420000
JWT_ACCESS_EXPIRATION_MS=420000
# Duração do refresh token (dias). Padrão: 7 dias
JWT_REFRESH_EXPIRATION_DAYS=7

# Cookie do refresh token (httpOnly)
# Produção (HTTPS): COOKIE_SECURE=true
# Se frontend e backend estiverem em domínios diferentes: COOKIE_SAMESITE=None
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ===== CORS =====
# Origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REFRESH_CAPACITY=10
RATE_LIMIT_LOGIN_CAPACITY=5

# ===== Workers & SSE =====
APP_WORKER_ENABLED=true
SSE_HEARTBEAT_MS=15000
