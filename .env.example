# Variáveis de ambiente obrigatórias do backend-biblioteca
# Copie para .env (ou defina no ambiente/sistema) antes de subir.

# ===== Banco de dados =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

# ===== JWT (obrigatório) =====
# Gere um segredo forte base64 com 256 bits:
#   openssl rand -base64 32
JWT_SECRET=cole_aqui_o_secret_gerado

# Durante rotação de segredo SEM downtime, coloque aqui o secret ANTERIOR.
# Tokens antigos continuam válidos; novos usam JWT_SECRET.
JWT_PREVIOUS_SECRET=

# Duração do access token (ms). Padrão: 7 minutos = 420000
JWT_ACCESS_EXPIRATION_MS=420000
# Duração do refresh token (dias). Padrão: 7
JWT_REFRESH_EXPIRATION_DAYS=7

# Cookie do refresh token (httpOnly).
# Produção (HTTPS): COOKIE_SECURE=true
# Se o frontend e a API estiverem em domínios diferentes: COOKIE_SAMESITE=None
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ===== CORS =====
# Liste as origens permitidas separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# ===== Rate limiting =====
# /api/auth/refresh: 10 req/min | /api/auth/login: 5 req/min
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REFRESH_CAPACITY=10
RATE_LIMIT_LOGIN_CAPACITY=5